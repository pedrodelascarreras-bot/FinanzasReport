{
  "name": "finanzas-app",
  "version": "1.0.0",
  "private": true,
  "description": "Tooling de validación de la app de finanzas personales",
  "scripts": {
    "build": "node scripts/build-static.mjs",
    "lint": "eslint js/**/*.js",
    "test:cuotas": "/System/Library/Frameworks/JavaScriptCore.framework/Versions/Current/Helpers/jsc tests/cuotas.test.js",
    "test:totals": "/System/Library/Frameworks/JavaScriptCore.framework/Versions/Current/Helpers/jsc tests/totals.test.js",
    "test:consistencia": "/System/Library/Frameworks/JavaScriptCore.framework/Versions/Current/Helpers/jsc tests/consistencia.test.js",
    "test": "npm run test:cuotas && npm run test:totals && npm run test:consistencia",
    "validate": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "eslint": "^9.24.0",
    "globals": "^16.0.0"
  }
}
